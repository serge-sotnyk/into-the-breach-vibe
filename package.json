{
  "name": "iron-grid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "IRON GRID - a turn-based mech tactics game inspired by Into the Breach",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "vitest run -c vitest.balance.config.ts"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/tektur": "^5.3.0"
  }
}
